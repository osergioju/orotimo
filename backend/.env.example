# Servidor
PORT=4000

# Autenticação (JWT real — HS256). Gere um segredo próprio, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Banco de dados — PostgreSQL (docker compose up -d db, na raiz do repo)
# Ajuste connection_limit/pool_timeout conforme a carga real (ver seção
# "Pool de conexões" do README do backend) — não travar um valor sem medir.
DATABASE_URL="postgresql://orotimo:orotimo@localhost:5433/orotimo?schema=public&connection_limit=10&pool_timeout=20"

# Solver (opcional — os defaults abaixo já funcionam com o venv versionado em /solver)
# SOLVER_DIR=/caminho/para/o/repo/solver
# SOLVER_PYTHON=/caminho/para/o/repo/solver/venv/bin/python3
